# Porta onde o gateway vai rodar na sua máquina
PORT=8787

# Chave para proteger o SEU gateway (invente uma senha qualquer)
GATEWAY_KEY=troque-por-uma-senha-forte

# --- Suas próprias chaves de API (legítimas, cada uma da sua conta) ---
# Preencha só as que você realmente tem. O gateway usa nesta ordem de fallback.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Orçamento de contexto: quantos tokens (aprox.) manter de histórico antes de comprimir/cortar
MAX_HISTORY_TOKENS=6000
