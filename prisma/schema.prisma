generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { SUPER_ADMIN ADMIN OPERATOR ENERGY_PARTNER WHITE_LABEL_OWNER CORPORATE_MANAGER LEADER CONSULTANT CUSTOMER }
enum ClientStatus { LEAD_NOVO DOCUMENTACAO_PENDENTE EM_ANALISE APROVADO REPROVADO MIGRACAO_SOLICITADA MIGRADO PRIMEIRA_FATURA_GERADA ATIVO INATIVO CANCELADO }
enum ClientType { RESIDENCIAL COMERCIAL RURAL INDUSTRIAL }
enum PartnerType { YNOVA COMERCIALIZADORA USINA COOPERATIVA MARKETPLACE WHITE_LABEL OUTRO }
enum CommissionBase { PRIMEIRA_FATURA FATURA_RECORRENTE TICKET_ADESAO RECEITA_LIQUIDA RECEITA_BRUTA }

model Tenant { id String @id @default(cuid()) name String slug String @unique logoUrl String? primaryColor String? active Boolean @default(true) users User[] clients EnergyClient[] whiteLabels WhiteLabel[] campaigns Campaign[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model User { id String @id @default(cuid()) tenantId String? tenant Tenant? @relation(fields:[tenantId],references:[id]) name String email String @unique phone String? passwordHash String? role UserRole @default(CONSULTANT) sponsorId String? sponsor User? @relation("UserSponsor",fields:[sponsorId],references:[id]) downline User[] @relation("UserSponsor") active Boolean @default(true) clients EnergyClient[] @relation("ConsultantClients") commissions Commission[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model EnergyPartner { id String @id @default(cuid()) name String type PartnerType description String? states String[] averageDiscountPercent Decimal? @db.Decimal(10,2) firstBillPayoutPercent Decimal? @db.Decimal(10,2) paysRecurring Boolean @default(false) recurringPercent Decimal? @db.Decimal(10,2) recurringDurationMonths Int? approvalAverageDays Int? migrationAverageDays Int? active Boolean @default(true) compensationPlans CompensationPlan[] clients EnergyClient[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model EnergyClient { id String @id @default(cuid()) tenantId String? tenant Tenant? @relation(fields:[tenantId],references:[id]) consultantId String? consultant User? @relation("ConsultantClients",fields:[consultantId],references:[id]) energyPartnerId String? energyPartner EnergyPartner? @relation(fields:[energyPartnerId],references:[id]) campaignId String? campaign Campaign? @relation(fields:[campaignId],references:[id]) corporateCompanyId String? corporateCompany CorporateCompany? @relation(fields:[corporateCompanyId],references:[id]) fullName String document String email String? phone String? clientType ClientType status ClientStatus @default(LEAD_NOVO) address String? city String? state String? utilityCompany String? averageBillValue Decimal? @db.Decimal(12,2) estimatedDiscountPercent Decimal? @db.Decimal(10,2) estimatedMonthlySavings Decimal? @db.Decimal(12,2) estimatedAnnualSavings Decimal? @db.Decimal(12,2) energyBillUrl String? notes String? approvedAt DateTime? migratedAt DateTime? firstBillAt DateTime? canceledAt DateTime? commissions Commission[] statusHistory ClientStatusHistory[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model ClientStatusHistory { id String @id @default(cuid()) clientId String client EnergyClient @relation(fields:[clientId],references:[id]) fromStatus ClientStatus? toStatus ClientStatus changedById String? changedBy User? @relation(fields:[changedById],references:[id]) notes String? createdAt DateTime @default(now()) }
model CompensationPlan { id String @id @default(cuid()) energyPartnerId String? energyPartner EnergyPartner? @relation(fields:[energyPartnerId],references:[id]) name String description String? active Boolean @default(true) levels CompensationLevel[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model CompensationLevel { id String @id @default(cuid()) compensationPlanId String compensationPlan CompensationPlan @relation(fields:[compensationPlanId],references:[id]) level Int percent Decimal @db.Decimal(10,2) base CommissionBase durationMonths Int? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Commission { id String @id @default(cuid()) clientId String client EnergyClient @relation(fields:[clientId],references:[id]) userId String user User @relation(fields:[userId],references:[id]) level Int base CommissionBase baseAmount Decimal @db.Decimal(12,2) percent Decimal @db.Decimal(10,2) amount Decimal @db.Decimal(12,2) ruleSnapshot Json calculationHash String? referenceMonth Int? referenceYear Int? approved Boolean @default(false) paid Boolean @default(false) paidAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model WhiteLabel { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) name String slug String @unique logoUrl String? primaryColor String? domain String? ownerName String? ownerEmail String? ownerPhone String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model CorporateCompany { id String @id @default(cuid()) name String document String? segment String? employeeCount Int? contactName String? contactEmail String? contactPhone String? city String? state String? campaignSlug String? @unique active Boolean @default(true) clients EnergyClient[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model Campaign { id String @id @default(cuid()) tenantId String? tenant Tenant? @relation(fields:[tenantId],references:[id]) name String slug String @unique description String? source String? active Boolean @default(true) clients EnergyClient[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model AuditLog { id String @id @default(cuid()) actorId String? entity String entityId String action String before Json? after Json? metadata Json? createdAt DateTime @default(now()) }
